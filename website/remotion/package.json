{
  "name": "pi-orbs-remotion",
  "private": true,
  "version": "0.0.0",
  "description": "Remotion compositions for the Pi Orbs site videos. Nested so root CI stays lean.",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio --public-dir ..",
    "preview": "remotion studio --public-dir ..",
    "render": "remotion render PiOrbs030 out/pi-orbs-0.3-release.mp4 --public-dir .. --codec h264",
    "render:peek": "remotion render PiOrbsPeek out/pi-orbs-peek.mp4 --codec h264",
    "still": "remotion still PiOrbs030 out/launch-poster.jpg --public-dir .. --frame 90",
    "check": "tsc"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "typescript": "^5.9.3"
  }
}
